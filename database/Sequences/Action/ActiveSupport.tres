[gd_resource type="Resource" script_class="ActionSequence" format=3 uid="uid://bml7a70biq7j5"]

[ext_resource type="Script" uid="uid://cn5b836p1hs1k" path="res://codings/Battle/Steps/Core/action_sequence_class.gd" id="seq"]
[ext_resource type="Script" uid="uid://cowuym37214qt" path="res://codings/Battle/Steps/Core/battle_step.gd" id="step"]
[ext_resource type="Script" uid="uid://dd3ha3vpos8w7" path="res://codings/Battle/Steps/Refs/actor_ref.gd" id="actor"]
[ext_resource type="Script" uid="uid://dbwr3h2q3mhk4" path="res://codings/Battle/Steps/Actor/actor_sprite_step.gd" id="sprite"]
[ext_resource type="Script" uid="uid://ipjg106xfgst" path="res://codings/Battle/Steps/Camera/camera_step.gd" id="camera"]
[ext_resource type="Script" uid="uid://c0wycllujccjw" path="res://codings/Battle/Steps/Presentation/effect_step.gd" id="effect"]
[ext_resource type="Script" uid="uid://dhhlbmxn3f342" path="res://codings/Battle/Steps/Flow/for_each_actor_step.gd" id="foreach"]
[ext_resource type="Script" uid="uid://cy7rvxnxpkw50" path="res://codings/Battle/Steps/Combat/stat_step.gd" id="stat"]
[ext_resource type="Script" uid="uid://bauq2mkx5erh8" path="res://codings/Battle/Steps/Refs/value_ref.gd" id="value"]
[ext_resource type="Script" uid="uid://bpbte2j6kwisc" path="res://codings/Battle/Steps/Flow/wait_step.gd" id="wait"]

[sub_resource type="Resource" id="Resource_caster"]
resource_name = "Caster"
script = ExtResource("actor")

[sub_resource type="Resource" id="Resource_loop"]
resource_name = "Loop Actor"
script = ExtResource("actor")
mode = 8

[sub_resource type="Resource" id="Resource_cast"]
script = ExtResource("sprite")
actor = SubResource("Resource_caster")
animation = &"Cast"

[sub_resource type="Resource" id="Resource_zoom"]
script = ExtResource("camera")
zoom_enabled = true
amount = 6.0
actor = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_focus"]
script = ExtResource("camera")
move_enabled = true
actor = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("effect")
effect_name = &"MagicUp"
target = SubResource("Resource_loop")

[sub_resource type="Resource" id="Resource_power"]
resource_name = "ability power"
script = ExtResource("value")
source = 0
value = 1.0

[sub_resource type="Resource" id="Resource_magic"]
script = ExtResource("stat")
stat = 3
actor = SubResource("Resource_loop")
value = SubResource("Resource_power")
turns = 1

[sub_resource type="Resource" id="Resource_each"]
script = ExtResource("foreach")
group = 3
exclude_caster = true
wait = false
stagger = 0.05
steps = Array[ExtResource("step")]([SubResource("Resource_effect"), SubResource("Resource_magic")])

[sub_resource type="Resource" id="Resource_wait"]
script = ExtResource("wait")
duration = 0.5

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("sprite")
actor = SubResource("Resource_caster")

[resource]
script = ExtResource("seq")
steps = Array[ExtResource("step")]([SubResource("Resource_cast"), SubResource("Resource_zoom"), SubResource("Resource_focus"), SubResource("Resource_each"), SubResource("Resource_wait"), SubResource("Resource_idle")])
