[sub_resource type="Resource" id="Resource_caster"]
resource_name = "Caster"
script = ExtResource("actor")

[sub_resource type="Resource" id="Resource_focus"]
script = ExtResource("camera")
move_enabled = true
actor = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_zoom"]
script = ExtResource("camera")
zoom_enabled = true
amount = 6.0
actor = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_wait_1"]
script = ExtResource("wait")

[sub_resource type="Resource" id="Resource_flip"]
script = ExtResource("sprite")
mode = 3
actor = SubResource("Resource_caster")
flip = true

[sub_resource type="Resource" id="Resource_fly"]
script = ExtResource("sprite")
actor = SubResource("Resource_caster")
animation = &"Fly"

[sub_resource type="Resource" id="Resource_hxuph"]
resource_name = "Caster"
script = ExtResource("actor")

[sub_resource type="Resource" id="Resource_kc4me"]
script = ExtResource("sprite")
mode = 4
actor = SubResource("Resource_hxuph")
flip = true

[sub_resource type="Resource" id="Resource_message"]
script = ExtResource("feedback")
mode = 2
message = "retreat"
insert = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_corner"]
resource_name = "(150, -150)"
script = ExtResource("position")
mode = 2
position = Vector2(150, -150)

[sub_resource type="Resource" id="Resource_move"]
script = ExtResource("move")
actor = SubResource("Resource_caster")
destination = SubResource("Resource_corner")
duration = 2.0
wait = false

[sub_resource type="Resource" id="Resource_wait_25"]
script = ExtResource("wait")
duration = 2.5

[sub_resource type="Resource" id="Resource_death"]
script = ExtResource("control")
mode = 9
actor = SubResource("Resource_caster")

[resource]
script = ExtResource("seq")
steps = Array[ExtResource("step")]([SubResource("Resource_focus"), SubResource("Resource_zoom"), SubResource("Resource_wait_1"), SubResource("Resource_flip"), SubResource("Resource_fly"), SubResource("Resource_kc4me"), SubResource("Resource_message"), SubResource("Resource_move"), SubResource("Resource_wait_25"), SubResource("Resource_death")])
