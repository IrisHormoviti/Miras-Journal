[sub_resource type="Resource" id="Resource_caster"]
resource_name = "Caster"
script = ExtResource("actor")

[sub_resource type="Resource" id="Resource_cast"]
script = ExtResource("sprite")
actor = SubResource("Resource_caster")
animation = &"Cast"

[sub_resource type="Resource" id="Resource_zoom"]
script = ExtResource("camera")
zoom_enabled = true
amount = 6.0
actor = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_dive"]
script = ExtResource("effect")
effect_name = &"HeatWave"
target = SubResource("Resource_caster")

[sub_resource type="Resource" id="Resource_wait_dive"]
script = ExtResource("wait")
duration = 0.5

[sub_resource type="Resource" id="Resource_loop"]
resource_name = "Loop Actor"
script = ExtResource("actor")
mode = 8

[sub_resource type="Resource" id="Resource_flame"]
script = ExtResource("effect")
effect_name = &"FlameSpark"
target = SubResource("Resource_loop")

[sub_resource type="Resource" id="Resource_f4bx1"]
script = ExtResource("9_pnko8")

[sub_resource type="Resource" id="Resource_314rh"]
resource_name = "Target"
script = ExtResource("actor")
mode = 1

[sub_resource type="Resource" id="Resource_aoq3c"]
script = ExtResource("10_nxerb")
actor = SubResource("Resource_314rh")

[sub_resource type="Resource" id="Resource_1f72h"]
resource_name = "Target"
script = ExtResource("actor")
mode = 1

[sub_resource type="Resource" id="Resource_fomww"]
script = ExtResource("11_wx4iu")
target = SubResource("Resource_1f72h")

[sub_resource type="Resource" id="Resource_medium"]
resource_name = "medium"
script = ExtResource("value")
damage_scale = 1

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("damage")
target = SubResource("Resource_loop")
power = SubResource("Resource_medium")
magic_mode = 2
elemental = true
hit_branch = false
hit_steps = Array[ExtResource("step")]([SubResource("Resource_f4bx1"), SubResource("Resource_aoq3c")])
miss_steps = Array[ExtResource("step")]([SubResource("Resource_fomww")])

[sub_resource type="Resource" id="Resource_crit"]
resource_name = "crit"
script = ExtResource("hit")
outcomes = 2

[sub_resource type="Resource" id="Resource_burn"]
script = ExtResource("state")
actor = SubResource("Resource_loop")
state = ExtResource("burned")
wait = false

[sub_resource type="Resource" id="Resource_burn_branch"]
script = ExtResource("branch")
condition = SubResource("Resource_crit")
if_steps = Array[ExtResource("step")]([SubResource("Resource_burn")])

[sub_resource type="Resource" id="Resource_enemies"]
script = ExtResource("foreach")
group = 4
wait = false
stagger = 0.15
steps = Array[ExtResource("step")]([SubResource("Resource_flame"), SubResource("Resource_damage"), SubResource("Resource_burn_branch")])

[sub_resource type="Resource" id="Resource_dead"]
resource_name = "Loop Actor health is at most 0"
script = ExtResource("statcond")
actor = SubResource("Resource_loop")
comparator = 5

[sub_resource type="Resource" id="Resource_revive_effect"]
script = ExtResource("effect")
effect_name = &"MagicUp"
target = SubResource("Resource_loop")

[sub_resource type="Resource" id="Resource_max_hp"]
resource_name = "max hp"
script = ExtResource("value")
source = 2
actor = SubResource("Resource_loop")

[sub_resource type="Resource" id="Resource_full_health"]
script = ExtResource("stat")
mode = 0
actor = SubResource("Resource_loop")
value = SubResource("Resource_max_hp")

[sub_resource type="Resource" id="Resource_revive_state"]
script = ExtResource("state")
mode = 1
actor = SubResource("Resource_loop")
state = ExtResource("knockedout")

[sub_resource type="Resource" id="Resource_revive_branch"]
script = ExtResource("branch")
condition = SubResource("Resource_dead")
if_steps = Array[ExtResource("step")]([SubResource("Resource_revive_effect"), SubResource("Resource_full_health"), SubResource("Resource_revive_state")])

[sub_resource type="Resource" id="Resource_allies"]
script = ExtResource("foreach")
group = 3
include_dead = true
exclude_caster = true
steps = Array[ExtResource("step")]([SubResource("Resource_revive_branch")])

[sub_resource type="Resource" id="Resource_idle"]
script = ExtResource("sprite")
actor = SubResource("Resource_caster")

[resource]
script = ExtResource("seq")
steps = Array[ExtResource("step")]([SubResource("Resource_cast"), SubResource("Resource_zoom"), SubResource("Resource_dive"), SubResource("Resource_wait_dive"), SubResource("Resource_enemies"), SubResource("Resource_allies"), SubResource("Resource_idle")])
