script = ExtResource("16_follow")

[sub_resource type="Resource" id="Resource_wuain"]
resource_name = "Party Member 1"
script = ExtResource("3_rehgr")
mode = 3
party_index = 1

[sub_resource type="Resource" id="Resource_b4vew"]
resource_name = "Party Member 1 dead"
script = ExtResource("4_6jeo0")
