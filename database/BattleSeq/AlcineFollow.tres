[sub_resource type="Resource" id="Resource_join_health"]
resource_name = "Mira health is less than 60"
script = ExtResource("15_stat")
actor = SubResource("Resource_join_mira")
comparator = 4
value = 60.0

[sub_resource type="Resource" id="Resource_join_condition"]
resource_name = "all 3 conditions"
script = ExtResource("12_all")
conditions = Array[ExtResource("13_condition")]([SubResource("Resource_join_flag"), SubResource("Resource_join_turn"), SubResource("Resource_join_health")])

