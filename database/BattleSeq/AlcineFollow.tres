[sub_resource type="Resource" id="Resource_join_flag"]
resource_name = "flag AlcineFollow4 = 1"
script = ExtResource("14_flag")
expression = &"AlcineFollow4 = 1"

[sub_resource type="Resource" id="Resource_join_turn"]
resource_name = "turn >= 5"
script = ExtResource("16_turn")
turn_min = 5

[sub_resource type="Resource" id="Resource_join_mira"]
