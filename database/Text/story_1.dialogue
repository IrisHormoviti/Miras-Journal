do travel_to("Pyrson;MapleBench+(0, 24)")
do zoom(5, true)
do no_player()
do spawn("Mira:MiraOVBag", "MapleBench+(24,150)", "DashUpLoop", 3)
do check.emit()
do tween_linear(npc("Mira"), "position", get_marker_pos("MapleBench+(24,32)"), 1)
do npc("Mira").set_anim("DashUpStop")
