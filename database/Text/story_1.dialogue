Mira: [small]*sniff.... sniffle...*
[hide]
do npc("Mira").look_to(Direction.RIGHT)
do wait(0.5)
do npc("Mira").look_to(Direction.LEFT)
do wait(0.5)
do npc("Mira").go_to("MapleBench+(24,0)")
do npc("Mira").go_to("MapleBench")
