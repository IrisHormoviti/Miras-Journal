~ nov3_morning
$> Item.add_item("LightweightAxe", &"Key", false, false)
$> Party.get_member("Mira").Weapon = load("res://database/Items/KeyItems/LightweightAxe.tres")
$> add_flag("LampInMirasRoom", false)
