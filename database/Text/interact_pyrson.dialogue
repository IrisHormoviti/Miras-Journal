import "res://database/Text/reserved_date.dialogue" as reserved_date

~ sleep_home
if date_is_reserved():
	=>< {{get_reserved_date_dialog()}}
elif time_of_day == 1:
	I just got up... should I go back to bed?
	if confirm_time_passage("Rest", "Will make me feel less tired."):
		$> Event.progress_by_time(1)
		$> Event.time_transition()
elif time_of_day == 5:
	if f_past("Player/eepy", 1):
		I'm exhausted.
	else:
		Bedtime.
	if confirm_time_passage("Sleep", "Sleep until next the morning."):
		$> Event.progress_by_time(1)
		$> Event.time_transition()
else:
	if add_flag("Player/eepy", 1):
		I do feel pretty tired... Should I take a quick nap?
	else:
		It's my bed.
	if confirm_time_passage("Rest", "Will make me feel less tired."):
		$> Transition.wipe()
		$> Event.progress_by_time(1)
		$> Event.time_transition()
		$> remove_flag("Player/eepy")
=> END

~ gather_pyrson
$> remove_flag("WitheredLeaves/InCamp")
if f_past("Player/eepy", 1):
	I don't have the energy to go out right now...
	$> give_control()
	=> END!
if day == 2:
	Seems to be a gate to whatever it was we used to enter.
	I... should probably not enter it myself right now, I'd get completely lost.
	$> give_control()
	=> END!
elif date_is_reserved():
	=>< {{get_reserved_date_dialog()}}
	$> give_control()
else:
	[[Should I gather the others?|Should I bring anyone else?|Let's call the others first.|Time to head out.]]
	- Gather allies
		[hide]
		$> Transition.wipe(Direction.LEFT)
		$> Party.add("Alcine")
		$> Party.add("Asteria")
		$> Party.add("Daze")
		$> zoom(5)
		$> wait(0.3, false)
		$> F1.position = player.position + Vector2(24, 0)
		$> F2.position = player.position + Vector2(24, 24)
		$> F3.position = player.position + Vector2(0, 24)
		$> F1.show()
		$> F2.show()
		$> F3.show()
		$> Hud.hide_all()
		$> Transition.unwipe()
		Ok, let's go.
		$> UI.veinet_map("Gate")
	- Go alone
		$> Party.reset_party()
		$> UI.veinet_map("Gate")
	- Don't go
	$> give_control()
=> END
