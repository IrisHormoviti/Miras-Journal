~ first_cutscene
$>> Global.player.move_by_tiles(Vector2.RIGHT * 2)
$> Transition.fade_in()
$> travel_to("TempleWoods", Vector2(1220, 461), 1, null, false)
$> player.hide()
$> camera_unlock()
$> camera_move(Vector2(1446, -605), 0)
$>> Transition.fade_out()
$>> camera_move(Vector2(1486, -300), 5, Ease.IN_OUT, Trans.LINEAR)
$>> wait(0.5)
$>> UI.location_name("Temple Woods")
$> wait(4.5)
$> camera_move(Vector2(1458, 400), 0)
$> camera_move(Vector2(1429, 450), 2, Ease.OUT)
if Input.is_action_pressed("Dash"):
