~ quick_rest
if date_is_reserved():
	=> {{get_reserved_date_dialog()}}
if Party.size() == 1:
	if Party.has_member("Mira"):
		Should I sit here for a bit?
elif Party.has_member("Mira"):
	Mira.Neutral: [[Wanna rest here for a bit?|Should we take a break?|Let's take a break.|Seems like a good place to rest.]]
do Event.progress_by_time(1)
if confirm_time_passage("Rest", "Fully restore health."):
	(hide)
	do heal_party()
	do! Event.time_transition()
=> END

~ rest_camp
if f("AlcineAlone"):
	Alcine.Neutral: Shwooo?
	=> END
It's the tent.
if date_is_reserved():
	=>< {{get_reserved_date_dialog()}}
else:
	do progress_by_time(1)
	if Hud.confirm_time_passage("Rest", "Stay in the camp for a while. Restores all Health."):
		do heal_party()
		do! time_transition()
=> END

~ WL_void
if Party.has_member_index("Mira") and Party.has_member_index("Daze"):
	Daze.Neutral: Ms. Levenor stop.
	Mira.Neutral: Huh?
	Daze takes a pebble and throws it forward.
	The pebble bounces around and changes shapes quickly until it disappears.
	Mira.Neutral: What- What is this?!
	Daze.Neutral: It is as I suspected.
	Daze.Neutral: This is the border of this realm. \nGoing beyond would be very dangerous.
	Mira.Neutral: The border of this realm?
	Daze.Neutral: Remember when I told you this place in not connected to the outside world? This is the limit.
	I keep staring into this void. 
	It's a lot like being on top of a tall building.
	The urge to just walk into it, even though I know I shouldn't.
	Mira.Neutral: Yeah...  let's walk the other way.
	do Event.add_flag("EvWLVoidMira")
=> END

~ daze_camp
if Day == 1
	if f_past("AlcineIsTheLeaderReal", 3):
		Mira.Neutral: {{alcine()}} should be the leader anyways.
		Daze.Neutral: I have a feeling I would be expelled from the team immediatly.
	elif f_past("AlcineIsTheLeaderReal", 1):
		Daze.Neutral: Who said I'm the leader in the first place?
		Mira.Neutral: Nobody!
		Mira.Neutral: Which is why I elect myself as the leader!!
		Daze.Neutral: What is your command, oh Leader of... uhh...
		Daze.Neutral: What exactly are you leading again?
		Mira.Neutral: [i]The Three Lost Souls, bravely adventuring through the mysterious ruins and forests..![/i]
		Mira.Neutral: ...Yeah, I dunno.
		if f_past("AlcineIsTheLeaderReal", 2):
			do add_flag("AlcineIsTheLeaderReal", 3)
	else:
		Mira.Neutral: Hey Daze, how old are you again?
		Daze.Neutral: 18, why?
		Mira.Neutral: WHAT!?
		Mira.Neutral: That makes me the oldest one here! I should be the leader!!!
		(hide)
		Daze looks down at me with a straight face, making it clear that he's a whole head taller than me.
		He proceeds to pat my head.
		Daze: That's cute.
		Daze.Neutral: Though I don't think you're getting anywhere with that broken arm of yours.
		Mira.Neutral: Exactly! A leader can just stay behind and give commands!
		Daze.Neutral: Or... get ambushed from behind.
		do add_flag("AlcineIsTheLeaderReal", 1)
elif Day == 2:
	Daze.Neutral: Shelter in a place like this, huh?
	Daze.Neutral: Well, I'm glad we won't have to share a tent anymore, no offense.
	Mira.Neutral: H-huh..?
	Daze.Neutral: Proper beds, protection from the elements, less snoring...
	Mira.Neutral: Snoring??
	Daze.Neutral: N- Not you in particular Levenor, I- I meant...
	Daze.Neutral: ...The creatures of the night! You know? They make all sorts of noises, it's uhh... hard to sleep with them.
	Mira.Smile: Hey, maybe if you keep jynxing it, we'll end up having to share a haystack instead.
=> END

~ alcine_camp
if Day == 1:
	if f_past("AlcineIsTheLeaderReal", 2):
		Mira.Neutral: Lead the way!
		Alcine.Neutral: Whim!
	elif f_past("AlcineIsTheLeaderReal", 1):
		Mira.Neutral: Psst, {{alcine()}}! How old are you?
		(hide)
		do npc("AlcineCamp").bubble("Question")
		{{alcine()}} seems unsure. Maybe more confused.
		Mira.Neutral: Not surprised, you could be a thousand years old for all I know.
		Mira.Neutral: Maybe you should be the leader!
		(hide)
		do npc("AlcineCamp").bubble("Ellipsis")
		do npc("AlcineCamp").bubble("Excited")
		{{alcine()}} thinks about it for a moment, then poses heroically at me.
		Mira.Neutral: Hehe, that's the spirit!
		do add_flag("AlcineIsTheLeaderReal", 2)
	else:
		Mira.Neutral: Why are you so scared of him..?
		Alcine.Neutral: Shewoom!!
		Mira.Neutral: I promise he doesn't bite...
elif Day == 2:
	Mira.Neutral: Hey {{alcine()}}, what do you think of her?
	Alcine.Neutral: Meeemmmm...
	do! npc("AlcineCamp").bubble("Excited")
	Alcine.Happy: Shaaa!
	Mira.Neutral: You like her? That's good.
=> END

